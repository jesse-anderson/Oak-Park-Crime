# CRITICAL: COOP/COEP headers for WASM with SharedArrayBuffer support
# These headers MUST be set on the HTML page that loads the WASM
/*.html
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Opener-Policy: same-origin
  Referrer-Policy: strict-origin-when-cross-origin

# Ensure WASM files are served correctly
/js/duckdb/*.wasm
  Content-Type: application/wasm
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Opener-Policy: same-origin
  Cache-Control: public, max-age=31536000, immutable

# Worker JS files
/js/duckdb/*.js
  Content-Type: application/javascript
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Opener-Policy: same-origin
  Cache-Control: public, max-age=86400

# Database files: data updates twice per day, so pin for 11 hours.
/db/*.duckdb
  Content-Type: application/octet-stream
  Cache-Control: public, max-age=39600

# Allow CORS for all assets (helps with worker loading)
/*
  Access-Control-Allow-Origin: *
