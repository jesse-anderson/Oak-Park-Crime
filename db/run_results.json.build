5Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.09199976921081543, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.opcrime.accepted_values_crimes_source__pdf__dashboard__both.677aa5beb0", "compiled": true, "compiled_code": "\n    \n    \n\nwith all_values as (\n\n    select\n        source as value_field,\n        count(*) as n_records\n\n    from \"opcrime_dbt\".\"main\".\"crimes\"\n    group by source\n\n)\n\nselect *\nfrom all_values\nwhere value_field not in (\n    'pdf','dashboard','both'\n)\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-09-10T09:56:02.589155Z", "completed_at": "2026-09-10T09:56:02.621155Z"}, {"name": "execute", "started_at": "2026-09-10T09:56:02.624155Z", "completed_at": "2026-09-10T09:56:02.709155Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.13249993324279785, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.opcrime.accepted_values_crimes_primary_crime_against__Person__Property__Society.bd32653430", "compiled": true, "compiled_code": "\n    \n    \n\nwith all_values as (\n\n    select\n        primary_crime_against as value_field,\n        count(*) as n_records\n\n    from \"opcrime_dbt\".\"main\".\"crimes\"\n    group by primary_crime_against\n\n)\n\nselect *\nfrom all_values\nwhere value_field not in (\n    'Person','Property','Society'\n)\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-09-10T09:56:02.732655Z", "completed_at": "2026-09-10T09:56:02.791155Z"}, {"name": "execute", "started_at": "2026-09-10T09:56:02.794155Z", "completed_at": "2026-09-10T09:56:02.828154Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.10700058937072754, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.opcrime.dbt_utils_unique_combination_of_columns_crimes_pdf_filename__block_position.00888532bf", "compiled": true, "compiled_code": "\n\n\n\n\n\nwith validation_errors as (\n\n    select\n        pdf_filename, block_position\n    from (select * from \"opcrime_dbt\".\"main\".\"crimes\" where pdf_filename is not null) dbt_subquery\n    group by pdf_filename, block_position\n    having count(*) > 1\n\n)\n\nselect *\nfrom validation_errors\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "warn", "timing": [{"name": "compile", "started_at": "2026-09-10T09:56:02.654154Z", "completed_at": "2026-09-10T09:56:02.661155Z"}, {"name": "execute", "started_at": "2026-09-10T09:56:02.664655Z", "completed_at": "2026-09-10T09:56:02.844655Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.23749947547912598, "adapter_response": {"_message": "OK"}, "message": "Got 25 results, configured to warn if != 0", "failures": 25, "unique_id": "test.opcrime.assert_no_complaint_collisions", "compiled": true, "compiled_code": "\n\n-- One complaint number on materially different incidents. A source data problem,\n-- so it is flagged rather than repaired per feedback_flag_dont_fix. Currently 25 groups.\n\nselect\n    complaint_num,\n    count(*)                  as row_count,\n    count(distinct date)      as distinct_dates,\n    count(distinct offense)   as distinct_offenses,\n    count(distinct location)  as distinct_locations\n\nfrom \"opcrime_dbt\".\"main\".\"crimes\"\nwhere complaint_num is not null\ngroup by complaint_num\nhaving count(*) > 1\n   and (count(distinct date) > 1\n        or count(distinct offense) > 1\n        or count(distinct location) > 1)", "relation_name": "\"opcrime_dbt\".\"main_dbt_test__audit\".\"assert_no_complaint_collisions\"", "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-09-10T09:56:02.847655Z", "completed_at": "2026-09-10T09:56:02.865655Z"}, {"name": "execute", "started_at": "2026-09-10T09:56:02.868155Z", "completed_at": "2026-09-10T09:56:02.924155Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.08699965476989746, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.opcrime.not_null_crimes_date.31173fcec1", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect date\nfrom \"opcrime_dbt\".\"main\".\"crimes\"\nwhere date is null\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-09-10T09:56:02.883655Z", "completed_at": "2026-09-10T09:56:02.915155Z"}, {"name": "execute", "started_at": "2026-09-10T09:56:02.916655Z", "completed_at": "2026-09-10T09:56:02.982155Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.11350011825561523, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.opcrime.not_null_crimes_record_id.d23baaa57d", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect record_id\nfrom \"opcrime_dbt\".\"main\".\"crimes\"\nwhere record_id is null\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "warn", "timing": [{"name": "compile", "started_at": "2026-09-10T09:56:02.729155Z", "completed_at": "2026-09-10T09:56:02.785155Z"}, {"name": "execute", "started_at": "2026-09-10T09:56:02.786155Z", "completed_at": "2026-09-10T09:56:03.006155Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.2990000247955322, "adapter_response": {"_message": "OK"}, "message": "Got 45 results, configured to warn if != 0", "failures": 45, "unique_id": "test.opcrime.assert_no_republished_pdf_duplicates", "compiled": true, "compiled_code": "\n\n-- Same incident ingested twice because OPPD republished the report under a new\n-- filename (-v2 against -v3, or an -02 suffix). Currently 45 groups, 48 rows\n-- double counted downstream. Flagged not fixed: the repair belongs in\n-- drop_exact_source_duplicates. See dbt_writeup.md.\n\nselect\n    complaint_num,\n    count(*)                                 as row_count,\n    string_agg(distinct pdf_filename, ' | ') as filenames\n\nfrom \"opcrime_dbt\".\"main\".\"crimes\"\nwhere complaint_num is not null\ngroup by complaint_num\nhaving count(*) > 1\n   and count(distinct date) = 1\n   and count(distinct offense) = 1\n   and count(distinct location) = 1\n   and count(distinct pdf_filename) > 1", "relation_name": "\"opcrime_dbt\".\"main_dbt_test__audit\".\"assert_no_republished_pdf_duplicates\"", "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-09-10T09:56:02.945155Z", "completed_at": "2026-09-10T09:56:02.982655Z"}, {"name": "execute", "started_at": "2026-09-10T09:56:02.985155Z", "completed_at": "2026-09-10T09:56:03.038155Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.13199996948242188, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.opcrime.relationships_crime_details_record_id__record_id__ref_crimes_.125285382f", "compiled": true, "compiled_code": "\n    \n    \n\nwith child as (\n    select record_id as from_field\n    from \"opcrime_dbt\".\"main\".\"crime_details\"\n    where record_id is not null\n),\n\nparent as (\n    select record_id as to_field\n    from \"opcrime_dbt\".\"main\".\"crimes\"\n)\n\nselect\n    from_field\n\nfrom child\nleft join parent\n    on child.from_field = parent.to_field\n\nwhere parent.to_field is null\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-09-10T09:56:03.010155Z", "completed_at": "2026-09-10T09:56:03.028155Z"}, {"name": "execute", "started_at": "2026-09-10T09:56:03.030155Z", "completed_at": "2026-09-10T09:56:03.202154Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.2025001049041748, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.opcrime.accepted_values_int_crimes_zoned_zone_id__1__2__3__4__5__6__7__8.c8ebed71ea", "compiled": true, "compiled_code": "\n    \n    \n\nwith all_values as (\n\n    select\n        zone_id as value_field,\n        count(*) as n_records\n\n    from \"opcrime_dbt\".\"main\".\"int_crimes_zoned\"\n    group by zone_id\n\n)\n\nselect *\nfrom all_values\nwhere value_field not in (\n    '1','2','3','4','5','6','7','8'\n)\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-09-10T09:56:03.039655Z", "completed_at": "2026-09-10T09:56:03.073655Z"}, {"name": "execute", "started_at": "2026-09-10T09:56:03.076655Z", "completed_at": "2026-09-10T09:56:03.246655Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.2154994010925293, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.opcrime.accepted_values_int_crimes_zoned_zone_status__in_village__snapped__outside_village__ungeocoded.fe63c9b33d", "compiled": true, "compiled_code": "\n    \n    \n\nwith all_values as (\n\n    select\n        zone_status as value_field,\n        count(*) as n_records\n\n    from \"opcrime_dbt\".\"main\".\"int_crimes_zoned\"\n    group by zone_status\n\n)\n\nselect *\nfrom all_values\nwhere value_field not in (\n    'in_village','snapped','outside_village','ungeocoded'\n)\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-09-10T09:56:03.091155Z", "completed_at": "2026-09-10T09:56:03.104155Z"}, {"name": "execute", "started_at": "2026-09-10T09:56:03.105156Z", "completed_at": "2026-09-10T09:56:03.257155Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.18599987030029297, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.opcrime.not_null_int_crimes_zoned_record_id.f8a6d8525b", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect record_id\nfrom \"opcrime_dbt\".\"main\".\"int_crimes_zoned\"\nwhere record_id is null\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-09-10T09:56:03.212154Z", "completed_at": "2026-09-10T09:56:03.228155Z"}, {"name": "execute", "started_at": "2026-09-10T09:56:03.228655Z", "completed_at": "2026-09-10T09:56:03.271654Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.06999945640563965, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.opcrime.not_null_int_crimes_zoned_zone_status.49f000ec3b", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect zone_status\nfrom \"opcrime_dbt\".\"main\".\"int_crimes_zoned\"\nwhere zone_status is null\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-10T09:56:03.289654Z", "completed_at": "2026-09-10T09:56:03.297155Z"}, {"name": "execute", "started_at": "2026-09-10T09:56:03.298654Z", "completed_at": "2026-09-10T09:56:03.365155Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.08100032806396484, "adapter_response": {"_message": "OK"}, "message": "OK", "failures": null, "unique_id": "model.opcrime.int_crimes_deduplicated", "compiled": true, "compiled_code": "-- Flags republication double counts without dropping them. Removing rows here\n-- would change published counts silently; downstream picks the filter.\n-- Highest filename sorts last for the -v2/-v3 and -02 suffix conventions.\nwith ranked as (\n\n    select\n        c.*,\n        q.quality_class,\n        case\n            when q.quality_class = 'republished'\n            then row_number() over (\n                partition by c.complaint_num\n                order by c.pdf_filename desc\n            )\n            else 1\n        end as republication_rank\n    from \"opcrime_dbt\".\"main\".\"stg_crimes\" as c\n    left join \"opcrime_dbt\".\"main\".\"int_complaint_quality\" as q\n        on c.complaint_num = q.complaint_num\n\n)\n\nselect\n    *,\n    republication_rank > 1 as is_duplicate_republication\nfrom ranked", "relation_name": "\"opcrime_dbt\".\"main\".\"int_crimes_deduplicated\"", "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-09-10T09:56:03.380155Z", "completed_at": "2026-09-10T09:56:03.403154Z"}, {"name": "execute", "started_at": "2026-09-10T09:56:03.405154Z", "completed_at": "2026-09-10T09:56:03.435155Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.0625, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.opcrime.not_null_int_crimes_deduplicated_record_id.0df7ac1aa0", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect record_id\nfrom \"opcrime_dbt\".\"main\".\"int_crimes_deduplicated\"\nwhere record_id is null\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-09-10T09:56:03.258655Z", "completed_at": "2026-09-10T09:56:03.274154Z"}, {"name": "execute", "started_at": "2026-09-10T09:56:03.277155Z", "completed_at": "2026-09-10T09:56:03.459155Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.20799994468688965, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.opcrime.unique_int_crimes_zoned_record_id.7e05a5b868", "compiled": true, "compiled_code": "\n    \n    \n\nselect\n    record_id as unique_field,\n    count(*) as n_records\n\nfrom \"opcrime_dbt\".\"main\".\"int_crimes_zoned\"\nwhere record_id is not null\ngroup by record_id\nhaving count(*) > 1\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-09-10T0