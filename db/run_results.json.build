d": "test.opcrime.unique_stg_crime_details_record_id.c429c74320", "compiled": true, "compiled_code": "\n    \n    \n\nselect\n    record_id as unique_field,\n    count(*) as n_records\n\nfrom \"opcrime_dbt\".\"main\".\"stg_crime_details\"\nwhere record_id is not null\ngroup by record_id\nhaving count(*) > 1\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-09-10T09:56:01.402655Z", "completed_at": "2026-09-10T09:56:01.440655Z"}, {"name": "execute", "started_at": "2026-09-10T09:56:01.446655Z", "completed_at": "2026-09-10T09:56:01.492155Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.1445002555847168, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.opcrime.unique_stg_crimes_record_id.f888974518", "compiled": true, "compiled_code": "\n    \n    \n\nselect\n    record_id as unique_field,\n    count(*) as n_records\n\nfrom \"opcrime_dbt\".\"main\".\"stg_crimes\"\nwhere record_id is not null\ngroup by record_id\nhaving count(*) > 1\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-09-10T09:56:01.516655Z", "completed_at": "2026-09-10T09:56:01.547155Z"}, {"name": "execute", "started_at": "2026-09-10T09:56:01.557655Z", "completed_at": "2026-09-10T09:56:01.606155Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.10849905014038086, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.opcrime.not_null_stg_policing_zones_zone_id.b5e906a3c4", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect zone_id\nfrom \"opcrime_dbt\".\"main\".\"stg_policing_zones\"\nwhere zone_id is null\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-09-10T09:56:01.529655Z", "completed_at": "2026-