"\nwhere location_key is null\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-10T09:56:01.660655Z", "completed_at": "2026-09-10T09:56:01.743155Z"}, {"name": "execute", "started_at": "2026-09-10T09:56:01.751155Z", "completed_at": "2026-09-10T09:56:01.888655Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.23900055885314941, "adapter_response": {"_message": "OK"}, "message": "OK", "failures": null, "unique_id": "model.opcrime.dim_date", "compiled": true, "compiled_code": "-- Spine excludes the 1900-01-01 parse-failure sentinel so the calendar covers\n-- only real reporting history.\nwith bounds as (\n\n    select\n        min(date) as first_date,\n        max(date) as last_date\n    from \"opcrime_dbt\".\"main\".\"stg_crimes\"\n    where date > '1901-01-01'\n\n), spine as (\n\n    select unnest(generate_series(first_date, last_date, interval 1 day)) as date_day\n    from bounds\n\n)\n\nselect\n    cast(date_day as date)          as date_day,\n    year(date_day)                  as year,\n    month(date_day)                 as month,\n    day(date_day)                   as day,\n    quarter(date_day)               as quarter,\n    week(date_day)                  as week,\n    dayofweek(date_day)             as day_of_week,\n    dayname(date_day)               as day_name,\n    monthname(date_day)             as month_name,\n    dayofweek(date_day) in (0, 6)   as is_weekend,\n    strftime(date_day, '%Y-%m')     as year_month,\n    strftime(date_day, '%Y-%m-%d')  as date_str\n\nfrom spine", "relation_name": "\"opcrime_dbt\".\"main\".\"dim_date\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-10T09:56:01.652155Z", "completed_at": "2026-09-10T09:56:01.663155Z"}, {"name": "execute", "started_at": "2026-09-10T09:56:01.667155Z", "completed_at": "2026-09-10T09:56:02.015154Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.3810005187988281, "adapter_response": {"_message": "OK"}, "message": "OK", "failures": null, "unique_id": "model.opcrime.crime_details", "compiled": true, "compiled_code": "select *\nfrom \"opcrime_dbt\".\"main\".\"stg_crime_details\"", "relation_name": "\"opcrime_dbt\".\"main\".\"crime_details\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-10T09:56:01.909654Z", "completed_at": "2026-09-10T09:56:01.916655Z"}, {"name": "execute", "started_at": "2026-09-10T09:56:01.918655Z", "completed_at": "2026-09-10T09:56:02.100655Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.19649982452392578, "adapter_response": {"_message": "OK"}, "message": "OK", "failures": null, "unique_id": "model.opcrime.dim_offense", "compiled": true, "compiled_code": "select\n    offense                       as offense_text,\n    max(primary_nibrs_code)       as primary_nibrs_code,\n    max(primary_crime_against)    as primary_crime_against,\n    max(primary_offense_type)     as primary_offense_type,\n    count(*)                      as incident_count,\n    min(date)                     as first_seen,\n    max(date)                     as last_seen\n\nfrom \"opcrime_dbt\".\"main\".\"stg_crimes\"\nwhere offense is not null\ngroup by offense", "relation_name": "\"opcrime_dbt\".\"main\".\"dim_offense\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-10T09:56:02.037654Z", "completed_at": "2026-09-10T09:56:02.050655Z"}, {"name": "execute", "started_at": "2026-09-10T09:56:02.051655Z", "completed_at": "2026-09-10T09:56:02.128155Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.10300087928771973, "adapter_response": {"_message": "OK"}, "message": "OK", "failures": null, "unique_id": "model.opcrime.int_complaint_quality", "compiled": true, "compiled_code": "-- One row per complaint number, classifying why it repeats. The two problem\n-- classes have different owners: republication is an ingest bug, collision is a\n-- source data issue we flag rather than repair.\nwith grouped as (\n\n    select\n        complaint_num,\n        count(*)                       as row_count,\n        count(distinct date)           as distinct_dates,\n        count(distinct offense)        as distinct_offenses,\n        count(distinct location)       as distinct_locations,\n        count(distinct pdf_filename)   as distinct_pdfs\n    from \"opcrime_dbt\".\"main\".\"stg_crimes\"\n    where complaint_num is not null\n    group by complaint_num\n\n)\n\nselect\n    *,\n    case\n        when row_count = 1 then 'unique'\n        when distinct_dates > 1\n          or distinct_offenses > 1\n          or distinct_locations > 1 then 'collision'\n        when distinct_pdfs > 1 then 'republished'\n        else 'other_duplicate'\n    end as quality_class\n\nfrom grouped", "relation_name": "\"opcrime_dbt\".\"main\".\"int_complaint_quality\"", "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-09-10T09:56:02.154655Z", "completed_at": "2026-09-10T09:56:02.166655Z"}, {"name": "execute", "started_at": "2026-09-10T09:56:02.168155Z", "completed_at": "2026-09-10T09:56:02.187654Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.043000221252441406, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.opcrime.not_null_dim_date_date_day.e3f312efb2", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect date_day\nfrom \"opcrime_dbt\".\"main\".\"dim_date\"\nwhere date_day is null\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-10T09:56:01.657655Z", "completed_at": "2026-09-10T09:56:01.676154Z"}, {"name": "execute", "started_at": "2026-09-10T09:56:01.743655Z", "completed_at": "2026-09-10T09:56:02.235655Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.6000003814697266, "adapter_response": {"_message": "OK"}, "message": "OK", "failures": null, "unique_id": "model.opcrime.crimes", "compiled": true, "compiled_code": "select\n    *,\n    year(date)                 as year,\n    month(date)                as month,\n    day(date)                  as day,\n    strftime(date, '%Y-%m-%d') as date_str\n\nfrom \"opcrime_dbt\".\"main\".\"stg_crimes\"", "relation_name": "\"opcrime_dbt\".\"main\".\"crimes\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-10T09:56:02.132155Z", "completed_at": "2026-09-10T09:56:02.141655Z"}, {"name": "execute", "started_at": "2026-09-10T09:56:02.143655Z", "completed_at": "2026-09-10T09:56:02.253155Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.13250017166137695, "adapter_response": {"_message": "OK"}, "message": "OK", "failures": null, "unique_id": "model.opcrime.int_crimes_zoned", "compiled": true, "compiled_code": "-- Ports prepare_crime_db.py assign_zones(), including its nearest-zone snap.\n-- The snap is a real business rule, not an implementation detail: edge-street\n-- geocodes on Harlem, Austin and North Ave land just outside the village polygon\n-- and would otherwise be dropped. Omitting it moves 1627 rows.\nwith pts as (\n\n    select\n        record_id,\n        lat,\n        long,\n        case when lat is not null then ST_Point(long, lat) end as pt\n    from \"opcrime_dbt\".\"main\".\"stg_crimes\"\n\n), candidates as (\n\n    select\n        p.record_id,\n        z.zone_id,\n        z.zone_name,\n        ST_Contains(z.zone_geom, p.pt) as contained,\n        ST_Distance(p.pt, z.zone_geom) as dist\n    from pts as p\n    cross join \"opcrime_dbt\".\"main\".\"stg_policing_zones\" as z\n    where p.pt is not null\n\n), best as (\n\n    select\n        record_id,\n        zone_id,\n        zone_name,\n        contained,\n        dist,\n        count(*) filter (where contained) over (partition by record_id) as contain_count\n    from candidates\n    qualify row_number() over (\n        partition by record_id\n        order by contained desc, dist asc, zone_id asc\n    ) = 1\n\n)\n\nselect\n    p.record_id,\n    p.lat,\n    p.long,\n    case when b.contained or b.dist < 0.0005 then b.zone_id   end as zone_id,\n    case when b.contained or b.dist < 0.0005 then b.zone_name end as zone_name,\n    coalesce(b.contain_count, 0) > 1 as zone_boundary_ambiguous,\n    case\n        when p.lat is null                                   then 'ungeocoded'\n        when b.contained                                     then 'in_village'\n        when b.dist < 0.0005   then 'snapped'\n        else 'outside_village'\n    end as zone_status\n\nfrom pts as p\nleft join best as b using (record_id)", "relation_name": "\"opcrime_dbt\".\"main\".\"int_crimes_zoned\"", "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-09-10T09:56:02.216155Z", "completed_at": "2026-09-10T09:56:02.229155Z"}, {"name": "execute", "started_at": "2026-09-10T09:56:02.230655Z", "completed_at": "2026-09-10T09:56:02.274155Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.07200002670288086, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.opcrime.unique_dim_date_date_day.d56fd19199", "compiled": true, "compiled_code": "\n    \n    \n\nselect\n    date_day as unique_field,\n    count(*) as n_records\n\nfrom \"opcrime_dbt\".\"main\".\"dim_date\"\nwhere date_day is not null\ngroup by date_day\nhaving count(*) > 1\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-09-10T09:56:02.260155Z", "completed_at": "2026-09-10T09:56:02.275654Z"}, {"name": "execute", "started_at": "2026-09-10T09:56:02.27