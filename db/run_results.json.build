crimes\" as c\nleft join \"opcrime_dbt\".\"main\".\"stg_geocode_cache\" as g\n    on c.location_key_naive = g.location_key", "relation_name": "\"opcrime_dbt\".\"main\".\"geocode_coverage\"", "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-09-10T09:56:09.039142Z", "completed_at": "2026-09-10T09:56:09.074642Z"}, {"name": "execute", "started_at": "2026-09-10T09:56:09.079142Z", "completed_at": "2026-09-10T09:56:09.114142Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.12199974060058594, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.opcrime.not_null_geocode_coverage_record_id.55cce1b548", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect record_id\nfrom \"opcrime_dbt\".\"main\".\"geocode_coverage\"\nwhere record_id is null\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-09-10T09:56:09.004142Z", "completed_at": "2026-09-10T09:56:09.073642Z"}, {"name": "execute", "started_at": "2026-09-10T09:56:09.075642Z", "completed_at": "2026-09-10T09:56:09.116642Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.125, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.opcrime.accepted_values_geocode_coverage_cache_status__hit__known_unresolvable__miss.98046d4a0f", "compiled": true, "compiled_code": "\n    \n    \n\nwith all_values as (\n\n    select\n        cache_status as value_field,\n        count(*) as n_records\n\n    from \"opcrime_dbt\".\"main\".\"geocode_coverage\"\n    group by cache_status\n\n)\n\nselect *\nfrom all_values\nwhere value_field not in (\n    'hit','known_unresolvable','miss'\n)\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-09-10T09:56:09.064142Z", "completed_at": "2026-09-10T09:56:09.081142Z"}, {"name": "execute", "started_at": "2026-09-10T09:56:09.086642Z", "completed_at": "2026-09-10T09:56:09.126142Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.13400030136108398, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.opcrime.unique_geocode_coverage_record_id.6c8966f3cc", "compiled": true, "compiled_code": "\n    \n    \n\nselect\n    record_id as unique_field,\n    count(*) as n_records\n\nfrom \"opcrime_dbt\".\"main\".\"geocode_coverage\"\nwhere record_id is not null\ngroup by record_id\nhaving count(*) > 1\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-09-10T09:56:09.048142Z", "completed_at": "2026-09-10T09:56:09.078141Z"}, {"name": "execute", "started_at": "2026-09-10T09:56:09.082642Z", "completed_at": "2026-09-10T09:56:09.129642Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.13650012016296387, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.opcrime.relationships_geocode_coverage_record_id__record_id__ref_stg_crimes_.c0d3f41636", "compiled": true, "compiled_code": "\n    \n    \n\nwith child as (\n    select record_id as from_field\n    from \"opcrime_dbt\".\"main\".\"geocode_coverage\"\n    where record_id is not null\n),\n\nparent as (\n    select record_id as to_field\n    from \"opcrime_dbt\".\"main\".\"stg_crimes\"\n)\n\nselect\n    from_field\n\nfrom child\nleft join parent\n    on child.from_field = parent.to_field\n\nwhere parent.to_field is null\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-10T09:56:09.142641Z", "completed_at": "2026-09-10T09:56:09.147142Z"}, {"name": "execute", "started_at": "2026-09-10T09:56:09.147641Z", "completed_at": "2026-09-10T09:56:09.643642Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.5040006637573242, "adapter_response": {"_message": "OK"}, "message": "OK", "failures": null, "unique_id": "model.opcrime.fct_incidents", "compiled": true, "compiled_code": "select\n    c.record_id,\n    c.complaint_num,\n    c.join_key,\n    c.source,\n    c.date,\n    cast(c.date as date)          as date_day,\n    c.offense,\n    c.primary_nibrs_code,\n    c.primary_crime_against,\n    c.primary_offense_type,\n    c.charge_count,\n    c.location,\n    c.lat,\n    c.long,\n    z.zone_id,\n    z.zone_name,\n    z.zone_status,\n    g.cache_status                as geocode_cache_status,\n    c.quality_class               as complaint_quality_class,\n    c.is_duplicate_republication,\n    c.pdf_filename,\n    c.pdf_url,\n    c.block_position,\n    c.incident_id_raw,\n    c.occur_datetime,\n    c.date_mismatch\n\nfrom \"opcrime_dbt\".\"main\".\"int_crimes_deduplicated\" as c\nleft join \"opcrime_dbt\".\"main\".\"int_crimes_zoned\"   as z on c.record_id = z.record_id\nleft join \"opcrime_dbt\".\"main\".\"geocode_coverage\"   as g on c.record_id = g.record_id", "relation_name": "\"opcrime_dbt\".\"main\".\"fct_incidents\"", "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-09-10T09:56:09.661642Z", "completed_at": "2026-09-10T09:56:09.700642Z"}, {"name": "execute", "started_at": "2026-09-10T09:56:09.702642Z", "completed_at": "2026-09-10T09:56:09.740642Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.0950002670288086, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.opcrime.accepted_values_fct_incidents_primary_crime_against__Person__Property__Society.dd9060a007", "compiled": true, "compiled_code": "\n    \n    \n\nwith all_values as (\n\n    select\n        primary_crime_against as value_field,\n        count(*) as n_records\n\n    from \"opcrime_dbt\".\"main\".\"fct_incidents\"\n    group by primary_crime_against\n\n)\n\nselect *\nfrom all_values\nwhere value_field not in (\n    'Person','Property','Society'\n)\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-09-10T09:56:09.671142Z", "completed_at": "2026-09-10T09:56:09.701642Z"}, {"name": "execute", "started_at": "2026-09-10T09:56:09.706642Z", "completed_at": "2026-09-10T09:56:09.745142Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.10149955749511719, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.opcrime.accepted_values_fct_incidents_source__pdf__dashboard__both.7bf25a490b", "compiled": true, "compiled_code": "\n    \n    \n\nwith all_values as (\n\n    select\n        source as value_field,\n        count(*) as n_records\n\n    from \"opcrime_dbt\".\"main\".\"fct_incidents\"\n    group by source\n\n)\n\nselect *\nfrom all_values\nwhere value_field not in (\n    'pdf','dashboard','both'\n)\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-09-10T09:56:09.680142Z", "completed_at": "2026-09-10T09:56:09.705642Z"}, {"name": "execute", "started_at": "2026-09-10T09:56:09.709642Z", "completed_at": "2026-09-10T09:56:09.748142Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.10150003433227539, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.opcrime.accepted_values_fct_incidents_zone_status__in_village__snapped__outside_village__ungeocoded.fb79efe54c", "compiled": true, "compiled_code": "\n    \n    \n\nwith all_values as (\n\n    select\n        zone_status as value_field,\n        count(*) as n_records\n\n    from \"opcrime_dbt\".\"main\".\"fct_incidents\"\n    group by zone_status\n\n)\n\nselect *\nfrom all_values\nwhere value_field not in (\n    'in_village','snapped','outside_village','ungeocoded'\n)\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-09-10T09:56:09.689142Z", "completed_at": "2026-09-10T09:56:09.708642Z"}, {"name": "execute", "started_at": "2026-09-10T09:56:09.713642Z", "completed_at": "2026-09-10T09:56:09.754642Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.10650038719177246, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.opcrime.dbt_utils_unique_combination_of_columns_fct_incidents_pdf_filename__block_position.bc10c60809", "compiled": true, "compiled_code": "\n\n\n\n\n\nwith validation_errors as (\n\n    select\n        pdf_filename, block_position\n    from (select * from \"opcrime_dbt\".\"main\".\"fct_incidents\" where pdf_filename is not null) dbt_subquery\n    group by pdf_filename, block_position\n    having count(*) > 1\n\n)\n\nselect *\nfrom validation_errors\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-09-10T09:56:09.774142Z", "completed_at": "2026-09-10T09:56:09.803142Z"}, {"name": "execute", "started_at": "2026-09-10T09:56:09.804642Z", "completed_at": "2026-09-10T09:56:09.833642Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.07200002670288086, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.opcrime.not_null_fct_incidents_record_id.f2ce792ed4", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect record_id\nfrom \"opcrime_dbt\".\"main\".\"fct_incidents\"\nwhere record_id is null\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-09-10T09:56:09.785642Z", "completed_at": "2026-09-10T09:56:09.807142Z"}, {"name": "execute", "started_at": "2026-09-10T09:56:09.809142Z", "completed_at": "2026-09-10T09:56:09.838142Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.07350015640258789, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.opcrime.not_null_fct_incidents_zone_status.c75faf4e88", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect zone_status\nfrom \"opcrime_dbt\".\"main\".\"fct_incidents\"\nwhere zone_status is null\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-09-10T09:56:09.794642Z", "completed_at": "2026-09-10T09:56:09.808142Z"}, {"name": "execute", "started_at": "2026-09-10T09:56:09.811641Z", "completed_at": "2026-09-10T09:56:09.843642Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.07599973678588867, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.opcrime.unique_fct_incidents_record_id.f48c591969", "compiled": true, "compiled_code": "\n    \n    \n\nselect\n    record_id as unique_field,\n    count(*) as n_records\n\nfrom \"opcrime_dbt\".\"main\".\"fct_incidents\"\nwhere record_id is not null\ngroup by record_id\nhaving count(*) > 1\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-10T09:56:09.868642Z", "completed_at": "2026-09-10T09:56:09.882642Z"}, {"name": "execute", "started_at": "2026-09-10T09:56:09.889642Z", "completed_at": "2026-09-10T09:56:10.153642Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.29649996757507324, "adapter_response": {"_message": "OK"}, "message": "OK", "failures": null, "unique_id": "model.opcrime.data_quality_summary", "compiled": true, "compiled_code": "-- Makes the known defects queryable rather than buried in test logs. The docs\n-- site renders test definitions but not outcomes, so this model is how a reader\n-- sees what is actually wrong with the data.\nwith checks as (\n\n    select 'republished_pdf_rows' as issue,\n           'Same incident ingested twice under a revised PDF filename' as description,\n           'ingest bug, fix in drop_exact_source_duplicates' as owner,\n           count(*) as row_count\n    from \"opcrime_dbt\".\"main\".\"fct_incidents\"\n    where is_duplicate_republication\n\n    union all\n    select 'complaint_collisions',\n           'One complaint number on materially different incidents',\n           'source data, flag only',\n           count(*)\n    from \"opcrime_dbt\".\"main\".\"fct_incidents\"\n    where complaint_quality_class = 'collision'\n\n    union all\n    select 'ungeocoded',\n           'No coordinates resolved',\n           'run a Python cache-fill',\n           count(*)\n    from \"opcrime_dbt\".\"main\".\"fct_incidents\"\n    where lat is null\n\n    union all\n    select 'geocode_cache_miss',\n           'Location absent from the shared geocode cache under the naive key',\n           'needs location_key published upstream',\n           count(*)\n    from \"opcrime_dbt\".\"main\".\"fct_incidents\"\n    where geocode_cache_status = 'miss'\n\n    union all\n    select 'outside_village',\n           'Geocoded outside the 8 policing zone polygons',\n           'expected, not a defect',\n           count(*)\n    from \"opcrime_dbt\".\"main\".\"fct_incidents\"\n    where zone_status = 'outside_village'\n\n    union all\n    select 'date_sentinel',\n           'Date failed to parse and fell back to 1900-01-01',\n           'source data, flag only',\n           count(*)\n    from \"opcrime_dbt\".\"main\".\"fct_incidents\"\n    where date <= '1901-01-01'\n\n    union all\n    select 'date_future',\n           'Incident date is in the future',\n           'source data, poisons naive freshness checks',\n           count(*)\n    from \"opcrime_dbt\".\"main\".\"fct_incidents\"\n    where date > current_date\n\n    union all\n    select 'pdf_dashboard_date_mismatch',\n           'PDF and dashboard disagree on the incident date by a day or more',\n           'flagged in merge_notes, not repaired',\n           count(*)\n    from \"opcrime_dbt\".\"main\".\"fct_incidents\"\n    where date_mismatch\n\n)\n\nselect\n    issue,\n    description,\n    owner,\n    row_count,\n    round(100.0 * row_count / (select count(*) from \"opcrime_dbt\".\"main\".\"fct_incidents\"), 2) as pct_of_rows\nfrom checks\norder by row_count desc", "relation_name": "\"opcrime_dbt\".\"main\".\"data_quality_summary\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-10T09:56:09.865642Z", "completed_at": "2026-09-10T09:56:09.881142Z"}, {"name": "execute", "started_at": "2026-09-10T09:56:09.883142Z", "completed_at": "2026-09-10T09:56:10.212642Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.3595006465911865, "adapter_response": {"_message": "OK"}, "message": "OK", "failures": null, "unique_id": "model.opcrime.agg_offense_trends", "compiled": true, "compiled_code": "select\n    offense,\n    primary_crime_against,\n    strftime(date, '%Y-%m')       as year_month,\n    year(date)                    as year,\n    count(*)                      as incident_count,\n    count(distinct zone_id)       as zones_touched,\n    count(*) filter (where zone_status = 'outside_village') as outside_village_count\n\nfrom \"opcrime_dbt\".\"main\".\"fct_incidents\"\nwhere date > '1901-01-01'\n  and offense is not null\ngroup by offense, primary_crime_against, year_month, year", "relation_name": "\"opcrime_dbt\".\"main\".\"agg_offense_trends\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-10T09:56:09.862642Z", "completed_at": "2026-09-10T09:56:09.874642Z"}, {"name": "execute", "started_at": "2026-09-10T09:56:09.875642Z", "completed_at": "2026-09-10T09:56:10.220642Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.3664999008178711, "adapter_response": {"_message": "OK"}, "message": "OK", "failures": null, "unique_id": "model.opcrime.agg_incidents_by_zone_month", "compiled": true, "compiled_code": "select\n    zone_id,\n    zone_name,\n    zone_status,\n    strftime(date, '%Y-%m')                     as year_month,\n    year(date)                                  as year,\n    month(date)                                 as month,\n    count(*)                                    as incident_count,\n    count(*) filter (where not is_duplicate_republication) as deduplicated_count,\n    count(distinct complaint_num)               as distinct_complaints,\n    count(*) filter (where primary_crime_against = 'Person')   as crimes_against_person,\n    count(*) filter (where primary_crime_against = 'Property') as crimes_against_property,\n    count(*) filter (where primary_crime_against = 'Society')  as crimes_against_society\n\nfrom \"opcrime_dbt\".\"main\".\"fct_incidents\"\nwhere date > '1901-01-01'\ngroup by zone_id, zone_name, zone_status, year_month, year, month", "relation_name": "\"opcrime_dbt\".\"main\".\"agg_incidents_by_zone_month\"", "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-09-10T09:56:10.181142Z", "completed_at": "2026-09-10T09:56:10.205142Z"}, {"name": "execute", "started_at": "2026-09-10T09:56:10.208142Z", "completed_at": "2026-09-10T09:56:10.254642Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.09299945831298828, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.opcrime.not_null_data_quality_summary_issue.1106ffc071", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect issue\nfrom \"opcrime_dbt\".\"main\".\"data_quality_summary\"\nwhere issue is null\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-09-10T09:56:10.191642Z", "completed_at": "2026-09-10T09:56:10.210642Z"}, {"name": "execute", "started_at": "2026-09-10T09:56:10.214142Z", "completed_at": "2026-09-10T09:56:10.257141Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.0904989242553711, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.opcrime.not_null_data_quality_summary_row_count.cceafbb9a7", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect row_count\nfrom \"opcrime_dbt\".\"main\".\"data_quality_summary\"\nwhere row_count is null\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-09-10T09:56:10.242142Z", "completed_at": "2026-09-10T09:56:10.258142Z"}, {"name": "execute", "started_at": "2026-09-10T09:56:10.259642Z", "completed_at": "2026-09-10T09:56:10.280142Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.044499874114990234, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.opcrime.unique_data_quality_summary_issue.257f0ff4ff", "compiled": true, "compiled_code": "\n    \n    \n\nselect\n    issue as unique_field,\n    count(*) as n_records\n\nfrom \"opcrime_dbt\".\"main\".\"data_quality_summary\"\nwhere issue is not null\ngroup by issue\nhaving count(*) > 1\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}], "elapsed_time": 9.8109872341156, "args": {"source_freshness_run_project_hooks": true, "project_dir": "C:\\Users\\Jesse\\Documents\\GitHub\\OP-Crime\\dbt", "use_fast_test_edges": false, "require_nested_cumulative_type_params": true, "use_v2_parser": false, "defer": false, "require_unique_project_resource_names": false, "require_ref_searches_node_package_before_root": false, "send_anonymous_usage_stats": true, "allow_jinja_file_extensions": false, "exclude": [], "print": true, "resource_types": [], "state_modified_compare_more_unrendered_values": true, "which": "build", "log_format": "default", "require_generic_test_arguments_property": true, "maximum_seed_size_mib": 1, "cache_selected_only": 